# 评论写手 .env 模板 — Wiki HTTP 模式
# 复制为 .env 后填实际值

# === Wiki API Server (本机局域网 IP) ===
WIKI_API_URL=http://192.168.x.x:8088
WIKI_API_KEY=deepsearch123

# === 知识库模式 ===
# "rag":    纯 Milvus RAG (原行为, 不调本机)
# "wiki":   纯 LLM-Wiki (强制走本机, 失败返回空)
# "hybrid": Wiki 优先, 失败降级 RAG (推荐)
KNOWLEDGE_MODE=hybrid

# === Milvus (本地, 服务器内已有) ===
MILVUS_HOST=localhost
MILVUS_PORT=19530

# === LLM (评论生成用) ===
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
